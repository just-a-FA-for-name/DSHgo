<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Android cannot express CIDRs here. EndpointPolicy restricts explicit
         HTTP URLs at the WebView and native request boundaries. HTTPS retains
         normal certificate checks; there is no automatic HTTP downgrade. -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
